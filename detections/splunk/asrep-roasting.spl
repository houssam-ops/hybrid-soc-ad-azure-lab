index=ad_lab earliest=-15m latest=now (source="WinEventLog:Security" OR source="XmlWinEventLog:Security") (EventCode=4768)
| rex field=_raw "<Data Name=\"TargetUserName\">(?<account_xml>[^<]+)</Data>"
| eval account=lower(coalesce(account_xml, TargetUserName, mvindex(Account_Name,-1), mvindex(Nom_du_compte,-1)))
| where isnotnull(account) AND account!="-"
| rex field=_raw "<Data Name=\"PreAuthType\">(?<preauth_xml>[^<]+)</Data>"
| rex field=_raw "<Data Name=\"Status\">(?<status_xml>[^<]+)</Data>"
| eval preauth=tostring(coalesce(preauth_xml,PreAuthType,Pre_Authentication_Type)), result=lower(coalesce(status_xml,Status,Result_Code))
| where preauth="0" AND (result="0x0" OR result="0")
| table _time host account preauth result
