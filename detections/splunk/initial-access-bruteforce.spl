index=ad_lab earliest=-15m latest=now (source="WinEventLog:Security" OR source="XmlWinEventLog:Security") (EventCode=4625)
| rex field=_raw "<Data Name=\"TargetUserName\">(?<account_xml>[^<]+)</Data>"
| eval account=lower(coalesce(account_xml, TargetUserName, mvindex(Account_Name,-1), mvindex(Nom_du_compte,-1)))
| where isnotnull(account) AND account!="-"
| rex field=_raw "<Data Name=\"IpAddress\">(?<src_xml>[^<]+)</Data>"
| eval src=coalesce(src_xml,IpAddress,Source_Network_Address,"unknown")
| bin _time span=5m
| stats count as failures values(src) as sources values(host) as hosts by _time account
| where failures>=3
