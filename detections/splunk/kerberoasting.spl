index=ad_lab earliest=-15m latest=now (source="WinEventLog:Security" OR source="XmlWinEventLog:Security") (EventCode=4769)
| rex field=_raw "<Data Name=\"TargetUserName\">(?<account_xml>[^<]+)</Data>"
| eval account=lower(coalesce(account_xml, TargetUserName, mvindex(Account_Name,-1), mvindex(Nom_du_compte,-1)))
| where isnotnull(account) AND account!="-"
| rex field=_raw "<Data Name=\"TicketEncryptionType\">(?<enc_xml>[^<]+)</Data>"
| rex field=_raw "<Data Name=\"Status\">(?<status_xml>[^<]+)</Data>"
| rex field=_raw "<Data Name=\"ServiceName\">(?<service_xml>[^<]+)</Data>"
| eval encryption=lower(coalesce(enc_xml,TicketEncryptionType,Ticket_Encryption_Type)), result=lower(coalesce(status_xml,Status,Failure_Code)), service=coalesce(service_xml,ServiceName,Service_Name)
| where (encryption="0x17" OR encryption="23") AND (result="0x0" OR result="0")
| stats count as tickets values(service) as services by account host
