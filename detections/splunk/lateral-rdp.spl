index=ad_lab earliest=-15m latest=now (source="WinEventLog:Security" OR source="XmlWinEventLog:Security") (EventCode=4624)
| rex field=_raw "<Data Name=\"TargetUserName\">(?<account_xml>[^<]+)</Data>"
| eval account=lower(coalesce(account_xml, TargetUserName, mvindex(Account_Name,-1), mvindex(Nom_du_compte,-1)))
| where isnotnull(account) AND account!="-"
| rex field=_raw "<Data Name=\"LogonType\">(?<type_xml>[^<]+)</Data>"
| rex field=_raw "<Data Name=\"IpAddress\">(?<src_xml>[^<]+)</Data>"
| eval logon_type=tostring(coalesce(type_xml,LogonType,Logon_Type)), src=coalesce(src_xml,IpAddress,Source_Network_Address,"unknown")
| where logon_type="10"
| bin _time span=5m
| stats count as logons values(host) as destinations by _time account src
