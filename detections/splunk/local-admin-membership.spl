index=ad_lab earliest=-15m latest=now (source="WinEventLog:Security" OR source="XmlWinEventLog:Security") (EventCode=4732)
| rex field=_raw "<Data Name=\"SubjectUserName\">(?<account_xml>[^<]+)</Data>"
| eval account=lower(coalesce(account_xml, SubjectUserName, mvindex(Account_Name,-1), mvindex(Nom_du_compte,-1)))
| where isnotnull(account) AND account!="-"
| rex field=_raw "<Data Name=\"TargetSid\">(?<group_sid_xml>[^<]+)</Data>"
| rex field=_raw "<Data Name=\"MemberSid\">(?<member_xml>[^<]+)</Data>"
| eval group_sid=coalesce(group_sid_xml,TargetSid,Group_Security_ID), member=coalesce(member_xml,MemberSid,Member_Security_ID)
| where group_sid="S-1-5-32-544"
| table _time host account group_sid member
