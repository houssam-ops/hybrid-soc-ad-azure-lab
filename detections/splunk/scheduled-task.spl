index=ad_lab earliest=-15m latest=now (source="WinEventLog:Security" OR source="XmlWinEventLog:Security") (EventCode=4698)
| rex field=_raw "<Data Name=\"SubjectUserName\">(?<account_xml>[^<]+)</Data>"
| eval account=lower(coalesce(account_xml, SubjectUserName, mvindex(Account_Name,-1), mvindex(Nom_du_compte,-1)))
| where isnotnull(account) AND account!="-"
| rex field=_raw "<Data Name=\"TaskName\">(?<task_xml>[^<]+)</Data>"
| eval task=coalesce(task_xml,TaskName,Task_Name)
| table _time host account task
